// Mutation testing of the streamed ZIP writer of downloads (docs/04 §5.6). composer
// mutation:zip counts code that no test reaches (--with-uncovered).
{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.10/resources/schema.json",
    "source": {
        "directories": ["src/Storage/Zip"]
    },
    "bootstrap": "tests/bootstrap.php",
    "phpUnit": {
        "configDir": "tests/Mutation"
    },
    "testFrameworkOptions": "--testsuite=zip",
    "timeout": 30,
    "tmpDir": ".tools/infection-zip-tmp",
    "logs": {
        "text": ".tools/infection-zip/infection.log",
        "summary": ".tools/infection-zip/summary.log",
        "github": true
    },
    // Floors at the scores measured on 2026-11-22 (97.98 % and 99.87 % covered), rounded down.
    // They may only rise. The one mutant that escapes is equivalent: a 33rd row of the matrix
    // in Crc32::power(), which no 32-bit vector reads.
    "minMsi": 97,
    "minCoveredMsi": 99,
    "mutators": {
        "@default": true
    }
}
