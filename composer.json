{
    "name": "cunaz/backups-for-restic",
    "description": "WordPress backups in the restic repository format, written in pure PHP.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*"
    },
    "require-dev": {
        "ext-sodium": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^12",
        "szepeviktor/phpstan-wordpress": "^2",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "suggest": {
        "ext-zstd": "Reads format 2 repositories created by restic, which always compresses their index and snapshot files.",
        "ext-curl": "Used by the WordPress HTTP API and by the development tools."
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "phpstan/phpstan",
                "version": "2.3.5",
                "description": "PHPStan from its release PHAR: GitHub source archives are not reachable from every CI and sandbox network.",
                "dist": {
                    "type": "file",
                    "url": "https://github.com/phpstan/phpstan/releases/download/2.3.5/phpstan.phar",
                    "shasum": "05eda8c51645fbb1cca6277a0bc2d2f9549d3f53"
                },
                "bin": [
                    "phpstan.phar"
                ]
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "BackupsForRestic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BackupsForRestic\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "analyse": "phpstan.phar analyse --memory-limit=1G",
        "test:unit": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit --testsuite unit"
        ],
        "test:database": "phpunit --testsuite database",
        "test:conformance": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit --testsuite conformance"
        ],
        "test:integration": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit -c phpunit-integration.xml.dist"
        ],
        "test": [
            "@test:unit",
            "@test:database",
            "@test:conformance"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test:unit"
        ],
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "bin/mutation-gate.sh --threads=max --with-uncovered"
        ],
        "mutation:planner": [
            "Composer\\Config::disableProcessTimeout",
            "bin/mutation-gate.sh --configuration=infection-planner.json5.dist --threads=max --with-uncovered --only-covering-test-cases src/Restore/ApplyPlan.php src/Restore/SiteLayout.php"
        ],
        "mutation:restore": [
            "Composer\\Config::disableProcessTimeout",
            "bin/mutation-gate.sh --configuration=infection-restore.json5.dist --threads=max --with-uncovered --only-covering-test-cases"
        ],
        "mutation:apply": [
            "Composer\\Config::disableProcessTimeout",
            "bin/mutation-gate.sh --configuration=infection-apply.json5.dist --threads=max --with-uncovered --only-covering-test-cases"
        ],
        "mutation:zip": [
            "Composer\\Config::disableProcessTimeout",
            "bin/mutation-gate.sh --configuration=infection-zip.json5.dist --threads=max --with-uncovered"
        ],
        "mutation:database": [
            "Composer\\Config::disableProcessTimeout",
            "bin/database-servers.sh bin/mutation-gate.sh --configuration=infection-database.json5.dist --with-uncovered --only-covering-test-cases"
        ],
        "fuzz": "php bin/fuzz.php --seconds=10",
        "bench": "php -d opcache.enable_cli=0 bin/bench.php",
        "pot": [
            "bin/build-package.sh",
            ".tools/bin/wp i18n make-pot build/backups-for-restic languages/backups-for-restic.pot --slug=backups-for-restic --domain=backups-for-restic"
        ]
    }
}
