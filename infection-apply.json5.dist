// Mutation testing of the file half of the apply jobs: plan build, file plans, file changes and
// their journal (docs/04 §5.6). composer mutation:apply counts code that no test reaches
// (--with-uncovered). The database half needs a server: infection-database.json5.dist.
{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.10/resources/schema.json",
    "source": {
        "directories": ["src/Jobs/Apply"],
        // The database half, with ExchangeSite, which only it uses: infection-database.json5.dist.
        "excludes": ["DatabaseChanges.php", "DatabaseGeneration.php", "DatabaseReview.php", "ExchangeSite.php"]
    },
    "bootstrap": "tests/bootstrap.php",
    "phpUnit": {
        "configDir": "tests/Mutation"
    },
    // The restore suite and the tests of the apply jobs' own classes (tests/Mutation/phpunit.xml.dist).
    "testFrameworkOptions": "--testsuite=apply",
    // Well above the time the durably writing test classes take under coverage (up to 11 s
    // on tmpfs and 18 s on ext4 on 2026-11-23), so that a slower runner skips none of their
    // mutants: Infection skips a mutant whose quickest covering test class took at least the
    // timeout in the initial run.
    "timeout": 60,
    "tmpDir": ".tools/infection-apply-tmp",
    "logs": {
        "text": ".tools/infection-apply/infection.log",
        "summary": ".tools/infection-apply/summary.log",
        "github": true
    },
    // Floors at the scores measured on 2026-11-27 with main at 3651682, the tests of
    // tests/Unit/Jobs/Apply and the tests' temporary files on tmpfs, as in CI: 94.77 % and 95.25 %
    // covered, rounded down; CI's run of the same tests (799b180) left the same mutants. Before
    // those tests the same code scored 80.59 % and 84.10 % covered (80.65 % and 84.16 % in CI).
    // They may only rise; the covered floor is above ADR 0024's goal of 90 %. Since job documents
    // and journal records are written durably (2026-11-22), fsync() failed under Infection's file
    // wrapper in every test that writes one, and the gate counted their mutants as killed: it
    // reported 100 % covered (docs/04 §5.6).
    "minMsi": 94,
    "minCoveredMsi": 95,
    "mutators": {
        "@default": true
    }
}
