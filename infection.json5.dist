// Mutation testing (ADR 0024): the gate for the code whose bugs would damage repositories.
// Run with: composer mutation (needs pcov or Xdebug, and bin/install-test-tools.sh infection).
{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.10/resources/schema.json",
    "source": {
        "directories": [
            "src/Crypto",
            "src/Format",
            "src/Engine/Forget"
        ]
    },
    // The source files end the request unless ABSPATH is defined; without this bootstrap,
    // Infection's own process exits silently with status 0 as soon as it reflects on a class.
    "bootstrap": "tests/bootstrap.php",
    // tests/Mutation/phpunit.xml.dist holds the tests of the mutated code; restic's real scrypt
    // cost (the slow group) is checked by the conformance suite instead of once per mutant.
    "phpUnit": {
        "configDir": "tests/Mutation"
    },
    "testFrameworkOptions": "--testsuite=mutation",
    "timeout": 60,
    "tmpDir": ".tools/infection-tmp",
    "logs": {
        "text": ".tools/infection/infection.log",
        "summary": ".tools/infection/summary.log",
        "github": true
    },
    "minCoveredMsi": 90,
    "mutators": {
        "@default": true
    }
}
