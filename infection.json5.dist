// Mutation testing (ADR 0024): the gate for the code whose bugs would damage repositories.
// Run with: composer mutation (needs pcov or Xdebug, and bin/install-test-tools.sh infection).
// The script passes --with-uncovered, so code that no test reaches counts against minMsi.
{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.10/resources/schema.json",
    "source": {
        "directories": [
            "src/Crypto",
            "src/Format",
            "src/Engine/Forget",
            "src/Database/Restore"
        ],
        // Classes of src/Database/Restore that only tests/Database reaches, against a real
        // server. infection-database.json5.dist measures them with a database; here they
        // would only count as not covered.
        "excludes": [
            "ExchangePlan.php",
            "Ledger.php",
            "MysqliConnection.php",
            "OwnedTables.php",
            "RehearsalReport.php",
            "SwapCatalog.php",
            "TableExchange.php",
            "TableImporter.php",
            "WordPressState.php",
            "WriteBarrier.php"
        ]
    },
    // The source files end the request unless ABSPATH is defined; without this bootstrap,
    // Infection's own process exits silently with status 0 as soon as it reflects on a class.
    "bootstrap": "tests/bootstrap.php",
    // tests/Mutation/phpunit.xml.dist holds the tests of the mutated code; restic's real scrypt
    // cost (the slow group) is checked by the conformance suite instead of once per mutant.
    "phpUnit": {
        "configDir": "tests/Mutation"
    },
    "testFrameworkOptions": "--testsuite=mutation",
    "timeout": 60,
    "tmpDir": ".tools/infection-tmp",
    "logs": {
        "text": ".tools/infection/infection.log",
        "summary": ".tools/infection/summary.log",
        "github": true
    },
    // The covered score is ADR 0024's merge gate. The score with uncovered code is a floor
    // at the value measured on 2026-11-23 with ext-zstd (89.31 %, 91.72 % covered, the same
    // in two runs; 87.99 % and 90.48 % before the compressed index files of #52, locally and
    // in CI), rounded down; raise it as tests are added, never lower it. The goal is 90 % for
    // both. Unlike the other gates' scores, this one barely moved when the tests stopped
    // running under Infection's file wrapper (docs/04 §5.6).
    "minCoveredMsi": 90,
    "minMsi": 89,
    "mutators": {
        "@default": true
    }
}
