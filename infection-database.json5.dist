// Mutation testing of the code that only a real database reaches: the import, the atomic
// exchange and the database half of the apply jobs, killed by tests/Unit/Database and
// tests/Database (docs/04 §5.6). Needs a MySQL server and the BFR_TEST_MYSQL_* variables of
// the database suite; .github/workflows/database-mutation.yml provides both. composer
// mutation:database counts code that no test reaches (--with-uncovered).
{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.10/resources/schema.json",
    "source": {
        "directories": ["src/Database/Restore", "src/Jobs/Apply"],
        // The file half of the apply jobs has its own gate: infection-apply.json5.dist.
        "excludes": ["ApplyJournal.php", "FileChanges.php", "FilePlans.php", "PlanBuild.php"]
    },
    "bootstrap": "tests/bootstrap.php",
    // Its own PHPUnit configuration, for a higher memory limit than the other gates' 128M.
    "phpUnit": {
        "configDir": "tests/Mutation/database"
    },
    // Each mutant process has a database server of its own, the one of its Infection thread
    // (tests/Support/DatabaseServers.php): bin/database-servers.sh runs one thread per server
    // that BFR_TEST_MYSQL_HOSTS names. So the test that lowers the server's max_allowed_packet
    // for a moment runs here too: a process that connects meanwhile is on another server, and a
    // mutant process first sets the limit back, which one stopped at its timeout inside that test
    // left lowered. From 2026-11-23 until then the gate left that test out, after 188 mutants
    // had counted as killed through it on one shared server.
    "testFrameworkOptions": "--testsuite=database",
    // Infection gives a mutant five seconds plus five times what its covering test classes took
    // in the initial run on the same machine, at most this many seconds, and it skips a mutant
    // whose quickest covering class took at least that long. At 60 seconds the limit, not the
    // tests, set the timeout of 3,863 of the 4,081 tested mutants (the exchange's test class
    // takes about 31 seconds with coverage on a runner), so a slow runner timed out mutants that
    // the tests let escape, and on a machine twice as slow Infection skipped 1,297 of them
    // (docs/04 §5.6). At 600 seconds the limit lies above five times the covering classes even
    // on a runner at half its speed, about 260 seconds: the timeout follows the measured time of
    // the tests.
    "timeout": 600,
    "tmpDir": ".tools/infection-database-tmp",
    "logs": {
        "text": ".tools/infection-database/infection.log",
        "summary": ".tools/infection-database/summary.log",
        "github": true
    },
    // Floors at the scores measured on 2026-11-26 with main at 932d979, whose code under
    // mutation and whose tests are those of e40ab18, with one server per process (docs/04
    // §5.6): 80.69 % and 84.59 % covered, with three processes on three MySQL 8.4.11 servers
    // and the tests' temporary files on tmpfs, as in CI. Until then the processes shared one
    // server, and DatabaseExchangeTest, which looks at the whole server, could fail through
    // another process whatever the mutation: CI's runs of the same code on one server scored
    // 81.58 % to 81.86 % and 85.52 % to 85.81 %, each with 40 to 52 kills more, and the floors of
    // 2026-11-23 lay within a point of the 80.67 % and 84.56 % that all three runs of that day
    // killed. With a server of its own each process meets only what its own tests do, so the
    // floors are now the whole numbers below what the tests kill. A run below them fails the
    // gate; they are lowered only as ADR 0024 says, by a change of its own that measures the
    // same commit again and shows a defect of the measurement. Otherwise they may only rise;
    // ADR 0024's 90 % is the goal. The 73.75 % and 79.20 % of 2026-11-20 were measured on older
    // code, under Infection's file wrapper, on which every durable write of a job document
    // failed.
    "minMsi": 80,
    "minCoveredMsi": 84,
    "mutators": {
        "@default": true
    }
}
