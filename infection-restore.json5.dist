// Mutation testing of file restore: staging, verification, the guarded file change, the disk
// plan and the snapshot browser (docs/04 §5.6). composer mutation:restore counts code that no
// test reaches (--with-uncovered). ApplyPlan and SiteLayout have their own 90 % gate in
// infection-planner.json5.dist.
{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.10/resources/schema.json",
    "source": {
        "directories": ["src/Restore"],
        "excludes": ["ApplyPlan.php", "SiteLayout.php"]
    },
    "bootstrap": "tests/bootstrap.php",
    "phpUnit": {
        "configDir": "tests/Mutation"
    },
    "testFrameworkOptions": "--testsuite=restore",
    "timeout": 30,
    "tmpDir": ".tools/infection-restore-tmp",
    "logs": {
        "text": ".tools/infection-restore/infection.log",
        "summary": ".tools/infection-restore/summary.log",
        "github": true
    },
    // Floors at the scores measured on 2026-11-20 (80.99 % and 85.48 % covered), rounded down.
    // They may only rise; ADR 0024's 90 % is the goal.
    "minMsi": 80,
    "minCoveredMsi": 85,
    "mutators": {
        "@default": true
    }
}
