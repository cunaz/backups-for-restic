<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration for mutation testing only (infection*.json5.dist): per gate the tests of the
    mutated code, so that each mutant runs in seconds. Engine-level tests that also reach this
    code, and the slow group with restic's real scrypt cost, stay with the main configuration.
    Kept apart from phpunit.xml.dist so that its suites can share files; each gate selects one.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="bootstrap.php"
         cacheDirectory="../../.phpunit.cache/mutation"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true">
    <php>
        <ini name="memory_limit" value="128M"/>
    </php>
    <testsuites>
        <testsuite name="mutation">
            <directory>../Unit/Crypto</directory>
            <directory>../Unit/Format</directory>
            <directory>../Unit/Support</directory>
            <directory>../Unit/Fuzz</directory>
            <directory>../Unit/Database</directory>
            <file>../Unit/Engine/ForgetTest.php</file>
            <file>../Unit/Engine/ForgetRunTest.php</file>
        </testsuite>
        <testsuite name="planner">
            <file>../Unit/Restore/ApplyPlanTest.php</file>
            <file>../Unit/Restore/PlannerPolicyTest.php</file>
            <file>../Unit/Restore/SiteLayoutTest.php</file>
        </testsuite>
        <!-- infection-restore.json5.dist and infection-apply.json5.dist. -->
        <testsuite name="restore">
            <directory>../Unit/Restore</directory>
            <file>../Unit/Jobs/FileChangesTest.php</file>
        </testsuite>
        <testsuite name="zip">
            <directory>../Unit/Storage/Zip</directory>
        </testsuite>
        <!-- Needs a MySQL server: infection-database.json5.dist. -->
        <testsuite name="database">
            <directory>../Unit/Database</directory>
            <directory>../Database</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>slow</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>../../src</directory>
        </include>
    </source>
</phpunit>
