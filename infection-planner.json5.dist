// Separate gate for reviewed file destinations and fresh-install path mapping.
// composer mutation:planner selects the two planner files from this source root and counts
// code that no test reaches (--with-uncovered) against minMsi.
{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.10/resources/schema.json",
    "source": {
        "directories": ["src/Restore"]
    },
    "bootstrap": "tests/bootstrap.php",
    "phpUnit": {
        "configDir": "tests/Mutation"
    },
    "testFrameworkOptions": "--testsuite=planner",
    "timeout": 15,
    "tmpDir": ".tools/infection-planner-tmp",
    "logs": {
        "text": ".tools/infection-planner/infection.log",
        "summary": ".tools/infection-planner/summary.log",
        "github": true
    },
    // Floors at the scores measured on 2026-11-23 with main at e40ab18 (87.45 % and 88.99 %
    // covered, the same in all four runs on this code, CI's included), rounded down
    // (docs/04 §5.6). They may only rise; 90 % is the goal.
    // The 96.64 % and 98.36 % of 2026-11-22 were measured while the tests ran under
    // Infection's file wrapper, which reports an unreadable file or a link to a removed file
    // as missing: two tests failed and two cleanups warned whatever the mutation
    // (docs/04 §5.6).
    "minCoveredMsi": 88,
    "minMsi": 87,
    "mutators": {
        "@default": true
    }
}
