<?xml version="1.0" encoding="UTF-8"?>
<!--
Integration tests against a running WordPress (bin/test-site.sh). Kept apart from phpunit.xml.dist
because they need the site, a database server and the restic tools; CI runs them in
.github/workflows/integration.yml.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <!-- In this order: the classes share one site, and the later ones need the repository that WordPressSiteTest sets up. -->
        <testsuite name="integration">
            <file>tests/Integration/AccessTest.php</file>
            <file>tests/Integration/WordPressSiteTest.php</file>
            <file>tests/Integration/HttpStreamingTest.php</file>
            <file>tests/Integration/JobControlTest.php</file>
            <file>tests/Integration/ScheduleTest.php</file>
            <file>tests/Integration/CliTest.php</file>
            <file>tests/Integration/AppendOnlyTest.php</file>
            <file>tests/Integration/MultisiteTest.php</file>
            <!-- Last: it removes everything the tests before it set up. -->
            <file>tests/Integration/UninstallTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
